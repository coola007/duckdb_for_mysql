[Unit]
Description=DuckDB MySQL Protocol Server
Documentation=https://github.com/duckdb/duckdb
After=network.target
Wants=network.target

[Service]
Type=simple
User=duckdb
Group=duckdb
ExecStart=/usr/local/bin/duckdb-mysql-server
ExecReload=/bin/kill -HUP $MAINPID
WorkingDirectory=/var/lib/duckdb
Environment=CONFIG_PATH=/etc/duckdb/config.json
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=duckdb-mysql
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# 安全设置
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/duckdb /var/log/duckdb
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target 